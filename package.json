{
  "name": "world-cup-2026-atlas",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "vite",
    "map:data": "node scripts/download-natural-earth-map-data.mjs",
    "build": "pnpm typecheck && vite build",
    "preview": "vite preview",
    "fix": "biome check --write . --max-diagnostics=none",
    "format": "pnpm fix",
    "check": "biome check .",
    "lint": "biome lint .",
    "check:test-policy": "node scripts/check-test-policy.mjs",
    "check:fixture-mapping": "node scripts/check-fixture-mapping.mjs",
    "check:policy": "pnpm check:test-policy",
    "check:worker-config": "wrangler deploy --dry-run --config wrangler.toml",
    "diagnose:live-results": "node scripts/diagnose-live-results.mjs",
    "poll:live-results": "node scripts/poll-live-results.mjs",
    "smoke:worker": "node scripts/smoke-check-worker.mjs",
    "typecheck": "tsc -p tsconfig.app.json --noEmit --pretty false --noErrorTruncation && tsc -p tsconfig.node.json --noEmit --pretty false --noErrorTruncation && tsc -p tsconfig.worker.json --noEmit --pretty false --noErrorTruncation",
    "lint:css": "stylelint \"src/**/*.css\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:coverage:workers": "vitest run --coverage --coverage.include=workers/results/src/**/*.{ts,tsx} --coverage.exclude=workers/results/src/**/*.test.{ts,tsx} --coverage.exclude=workers/results/src/**/*.spec.{ts,tsx} --coverage.exclude=workers/results/src/**/*.contract.test.{ts,tsx} --coverage.exclude=workers/results/src/**/*.integration.test.{ts,tsx} --coverage.exclude=workers/results/src/test/** --coverage.thresholds.lines=85 --coverage.thresholds.statements=85 --coverage.thresholds.functions=85 --coverage.thresholds.branches=63 workers/results/src",
    "e2e": "playwright test",
    "e2e:verbose": "PLAYWRIGHT_VERBOSE=true playwright test",
    "e2e:ui": "playwright test --ui",
    "verify": "pnpm check && pnpm check:policy && pnpm check:fixture-mapping && pnpm lint:css && pnpm typecheck && pnpm test && pnpm build && pnpm check:worker-config && pnpm test:coverage && pnpm test:coverage:workers",
    "verify:full": "pnpm verify && pnpm e2e",
    "ready": "pnpm fix && pnpm verify"
  },
  "dependencies": {
    "@preact/signals": "^2.0.0",
    "preact": "^10.26.9"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.16",
    "@playwright/test": "1.56.1",
    "@preact/preset-vite": "^2.10.2",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/preact": "^3.2.4",
    "@types/node": "^24.5.2",
    "@vitest/coverage-v8": "^3.2.4",
    "jsdom": "^26.1.0",
    "stylelint": "17.13.0",
    "stylelint-config-standard": "40.0.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "vitest": "^3.2.4",
    "wrangler": "4.50.0"
  }
}
