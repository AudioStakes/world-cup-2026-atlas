{
  "name": "world-cup-2026-atlas",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "vite",
    "map:data": "node scripts/download-natural-earth-map-data.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "fix": "biome check --write .",
    "format": "pnpm fix",
    "check": "biome check .",
    "lint": "biome lint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "verify": "pnpm check && pnpm typecheck && pnpm test && pnpm build",
    "verify:full": "pnpm verify && pnpm e2e",
    "ready": "pnpm fix && pnpm verify"
  },
  "dependencies": {
    "@preact/signals": "^2.0.0",
    "preact": "^10.26.9"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.16",
    "@playwright/test": "1.56.1",
    "@preact/preset-vite": "^2.10.2",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/preact": "^3.2.4",
    "@types/node": "^24.5.2",
    "@vitest/coverage-v8": "^3.2.4",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "vitest": "^3.2.4"
  }
}
